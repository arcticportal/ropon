server {
    listen 80;
    server_name ${NGINX_MEDIA_SERVER_NAME};

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    location /media/ {
        alias /usr/share/nginx/html/media/;

        # Cache configuration
        expires ${NGINX_MEDIA_CACHE_EXPIRES};
        add_header Cache-Control "public, max-age=${NGINX_MEDIA_CACHE_MAX_AGE}";
        add_header ETag on;

        # CORS configuration
        add_header Access-Control-Allow-Origin "${NGINX_MEDIA_CORS_ALLOWED_ORIGINS}";
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
        add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept";

        # Handle preflight requests
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin "${NGINX_MEDIA_CORS_ALLOWED_ORIGINS}";
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
            add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept";
            add_header Access-Control-Max-Age 1728000;
            add_header Content-Type 'text/plain; charset=utf-8';
            add_header Content-Length 0;
            return 204;
        }

        # Enable gzip compression for applicable file types
        gzip on;
        gzip_types
            image/jpeg
            image/png
            image/gif
            image/webp
            application/pdf
            text/plain
            text/css
            application/json
            application/javascript
            text/xml
            application/xml;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}