# =============================================================================
# RoPON environment configuration template
# =============================================================================
# Copy this file to '.env.dev' or '.env.prd' and fill in real values.
#   cp deploy/.env_example deploy/.env.dev
#
# IMPORTANT: Never commit real .env files. They are git-ignored.
# All secrets (marked CHANGE_ME) must be set before first boot.
# =============================================================================


# ---------- Django configuration ----------
DJANGO_SUPERUSER_USERNAME='admin'
# Set a strong password; change it after first login in the Wagtail admin.
DJANGO_SUPERUSER_PASSWORD='CHANGE_ME'
DJANGO_SUPERUSER_EMAIL='admin@your-domain.org'

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Use a DIFFERENT key for dev vs production.
DJANGO_SECRET_KEY='CHANGE_ME'

# Comma-separated list of host/domain names the backend will serve.
DJANGO_ALLOWED_HOSTS='dashboard.your-domain.org'

# Settings module: ropon.settings.dev (development) or ropon.settings.prd (production)
DJANGO_SETTINGS_MODULE='ropon.settings.prd'
DJANGO_PORT=8000
# Set to true only for local/debugging. Production MUST be false.
DEBUG=false


# ---------- Media configuration ----------
MEDIA_ROOT='/srv/media'
# Public URL where uploaded media is served (via the nginx-media service).
MEDIA_URL='https://media.your-domain.org/media/'


# ---------- Nginx Media Service configuration ----------
NGINX_MEDIA_SERVER_NAME='media.your-domain.org'
# Comma-separated origins allowed to fetch media (dashboard + frontend URLs).
NGINX_MEDIA_CORS_ALLOWED_ORIGINS='https://dashboard.your-domain.org,https://your-domain.org,https://www.your-domain.org'
NGINX_MEDIA_CACHE_EXPIRES='30d'
NGINX_MEDIA_CACHE_MAX_AGE='2592000'


# ---------- Gunicorn configuration ----------
# Uncomment and modify these values only if you need to override the defaults.
# GUNICORN_WORKERS_PER_CORE=2
# GUNICORN_MAX_WORKERS=8
# GUNICORN_TIMEOUT=30
# GUNICORN_GRACEFUL_TIMEOUT=60
# GUNICORN_THREADS=4
# GUNICORN_LOG_LEVEL=info


# ---------- Wagtail configuration ----------
WAGTAIL_SITE_NAME='Registry of Polar Observing Networks'

# Comma-separated trusted origins for CSRF (no scheme needed; https is added automatically).
CSRF_TRUSTED_ORIGINS='dashboard.your-domain.org'

# Comma-separated origins allowed to make cross-origin requests to the API.
CORS_ALLOWED_ORIGINS='your-domain.org,www.your-domain.org,dashboard.your-domain.org'

# Base URL of the Wagtail admin (used in emails, etc.).
WAGTAILADMIN_BASE_URL='https://dashboard.your-domain.org'

# Maximum number of results returned per API request (leave unset for no limit).
# WAGTAILAPI_LIMIT_MAX=200

# Disable commenting in page editors.
WAGTAILADMIN_COMMENTS_ENABLED=False
# Allow password reset for users.
WAGTAIL_PASSWORD_RESET_ENABLED=True
WAGTAILUSERS_PASSWORD_REQUIRED=False

# Email address that receives contact-form submissions.
ROPON_ADMIN_EMAIL='info@your-domain.org'

WAGTAIL_ENABLE_WHATS_NEW_BANNER=False
WAGTAIL_ENABLE_UPDATE_CHECK=False


# ---------- PostgreSQL configuration ----------
POSTGRES_DB='ropon'
POSTGRES_USER='postgres'
# Set a strong, unique password for the database user.
POSTGRES_PASSWORD='CHANGE_ME'
# Service name of the Postgres container (as defined in the compose file).
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ---------- Redis configuration ----------
# Service name of the Redis container. Leave empty to use local-memory caching.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0


# ---------- Frontend configuration ----------
# Public URL of the Angular frontend (used to build links from the backend).
FRONTEND_URL='https://your-domain.org'


# ---------- Wagtail Guide package settings ----------
ADD_WAGTAIL_GUIDE_TO_HELP_MENU=False
WAGTAIL_GUIDE_MENU_LABEL="Editor's Guide"
HIDE_WAGTAIL_CORE_EDITOR_GUIDE=True


# ---------- Email configuration ----------
# SMTP server for sending email (contact form, notifications).
# EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=465  # 587 for TLS
EMAIL_HOST_USER='info@your-domain.org'
# SMTP password — keep secret, never commit.
# EMAIL_HOST_PASSWORD='CHANGE_ME'
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL='info@your-domain.org'
